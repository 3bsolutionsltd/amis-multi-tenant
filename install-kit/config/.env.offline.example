# ── AMIS Offline Environment — fill in every value ───────────────────────────
# Copy this file to .env.offline and complete all REQUIRED fields, or let
# install.sh generates them for you interactively.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_USER=amis
# REQUIRED  Strong random string (min 16 chars, no '$').
#           Generate: openssl rand -base64 24
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=amis

# ── Auth ─────────────────────────────────────────────────────────────────────
# REQUIRED  64 random hex bytes.
#           Generate: openssl rand -hex 64
JWT_SECRET=change-me-to-a-64-byte-random-hex-string

# ── Web / CORS ───────────────────────────────────────────────────────────────
# The canonical URL staff will use in their browsers.
# Use the same IP address or LAN hostname entered in install.sh.
CORS_ORIGIN=http://amis-server.local
