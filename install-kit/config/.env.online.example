AMIS_VERSION=0.25.6
AMIS_IMAGE_REGISTRY=ghcr.io/3bsolutionsltd

POSTGRES_USER=amis
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=amis
APP_DATABASE_URL=postgres://amis_app:replace-with-app-password@db:5432/amis?sslmode=disable
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGIN=http://192.168.1.100
APP_URL=http://192.168.1.100

# Configure either Resend or SMTP.
RESEND_API_KEY=
RESEND_FROM=AMIS <noreply@amis.institute>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=AMIS <noreply@amis.institute>
SMTP_SECURE=false