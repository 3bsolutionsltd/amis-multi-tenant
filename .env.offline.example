# ── AMIS Offline Environment — UTC Kyema On-Premises Server ──────────────────
# Copy this file to .env.offline and fill in every value.
# Run: docker compose -f docker-compose.offline.yml --env-file .env.offline up -d
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=amis
# REQUIRED: Set a strong password (min 16 characters, no $ signs)
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=amis

# ── Auth ──────────────────────────────────────────────────────────────────────
# REQUIRED: Generate with (on Linux/Mac): openssl rand -hex 64
#           Or on Windows: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me-to-a-64-byte-random-hex-string

# ── API ───────────────────────────────────────────────────────────────────────
# The LAN URL where the web app is served from (used for CORS).
# Set to http://<server-LAN-ip> — no trailing slash.
# Example: CORS_ORIGIN=http://192.168.1.100
CORS_ORIGIN=http://192.168.1.100

# ── Web (baked into the React bundle at image build time) ─────────────────────
# NOTE: This value is baked in during `build-offline-bundle.ps1` — do not
# change it here after the image is already built. Re-run the build script
# with the correct SERVER_IP if the server IP ever changes.
# Format: http://<server-LAN-ip>:3001
VITE_API_URL=http://192.168.1.100:3001
