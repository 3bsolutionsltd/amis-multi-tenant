# ── AMIS Staging Environment Variables ───────────────────────────────────────
# Copy this file to .env.staging and fill in real values.
# NEVER commit .env.staging to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_USER=amis
POSTGRES_PASSWORD=change_me_staging_db_password
POSTGRES_DB=amis_staging

# ── JWT ───────────────────────────────────────────────────────────────────────
# Use a DIFFERENT secret from production
JWT_SECRET=change_me_staging_jwt_secret_min_32_chars

# ── CORS / API URL ────────────────────────────────────────────────────────────
# The browser-visible API origin (used by the web build and CORS allow-list)
CORS_ORIGIN=https://pre.amis.institute
VITE_API_URL=https://api.pre.amis.institute

# ── Environment label (baked into the web build at compile time) ──────────────
# Shows a visible "STAGING" banner across the top of the UI.
# Leave unset (or remove) for production builds.
VITE_APP_ENV=staging
